@page
@model KadrySystem.Areas.Identity.Pages.Account.LoginModel

<h2>Вход в систему</h2>

<form method="post">
    <div class="form-group">
        <label>Email</label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <label>Пароль</label>
        <input asp-for="Input.Password" type="password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Войти</button>
</form>

<a href="/Identity/Account/Register">Нет аккаунта? Зарегистрироваться</a>