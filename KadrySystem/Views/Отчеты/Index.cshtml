@{
    ViewData["Title"] = "Отчеты";
}

<h1>Отчеты</h1>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Отчет по сотрудникам</h5>
                <p class="card-text">Список всех сотрудников с должностями и подразделениями</p>
                <a asp-action="ОтчетПоСотрудникам" class="btn btn-primary">Сформировать</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Отчет по приказам</h5>
                <p class="card-text">Список всех кадровых приказов</p>
                <a asp-action="ОтчетПоПриказам" class="btn btn-primary">Сформировать</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Отчет по штатному расписанию</h5>
                <p class="card-text">Штатная численность и вакансии</p>
                <a asp-action="ОтчетПоШтатномуРасписанию" class="btn btn-primary">Сформировать</a>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Администратор"))
{
    <hr />
    <h2>Администрирование</h2>
    <div class="row">
        <div class="col-md-4">
            <div class="card mb-3 bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Резервное копирование</h5>
                    <p class="card-text">Создание резервной копии базы данных</p>
                    <a asp-action="РезервноеКопирование" class="btn btn-dark">Перейти</a>
                </div>
            </div>
        </div>
    </div>
}
