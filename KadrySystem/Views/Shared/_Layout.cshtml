<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Кадровая система</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-id-card"></i> HR<span style="font-weight:300">ИМСИТ</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i>Главная</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Сотрудники" asp-action="Index"><i class="fas fa-users"></i>Сотрудники</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Должности" asp-action="Index"><i class="fas fa-briefcase"></i>Должности</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Подразделения" asp-action="Index"><i class="fas fa-building"></i>Подразделения</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Приказы" asp-action="Index"><i class="fas fa-file-signature"></i>Приказы</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ШтатноеРасписание" asp-action="Index"><i class="fas fa-chart-simple"></i>Штат</a></li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <main>
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="container text-center">
            <span>© @DateTime.Now.Year Кадровая система Академического колледжа ИМСИТ</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>