@@model IEnumerable<KadrySystem.Models.Подразделение>

@{
    ViewData["Title"] = "Подразделения";
}

    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-building me-2" style="color:#2c5f8a"></i>Подразделения</h1>
            <p>Структурные подразделения Академического колледжа ИМСИТ</p>
        </div>
        <a asp-action="Create" class="btn btn-add"><i class="fas fa-plus me-2"></i>Добавить подразделение</a>
    </div>

    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Наименование</th>
                    <th>Телефон</th>
                    <th style="width: 150px">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Наименование</strong></td>
                        <td>@item.Телефон</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Код_подразделения" class="btn btn-action btn-edit"><i class="fas fa-edit"></i> Ред.</a>
                            <a asp-action="Delete" asp-route-id="@item.Код_подразделения" class="btn btn-action btn-delete"><i class="fas fa-trash"></i> Уд.</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
