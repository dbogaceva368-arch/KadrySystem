@model KadrySystem.Models.Подразделение

@{
    ViewData["Title"] = "Добавление подразделения";
}

<div class="form-card">
    <h1><i class="fas fa-plus-circle me-2"></i>Добавление подразделения</h1>
    <hr />
    <form asp-action="Create">
        <div class="form-group">
            <label>Наименование</label>
            <input asp-for="Наименование" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Телефон</label>
            <input asp-for="Телефон" class="form-control" />
        </div>
        <button type="submit" class="btn btn-save"><i class="fas fa-save me-2"></i>Сохранить</button>
        <a asp-action="Index" class="btn btn-back"><i class="fas fa-arrow-left me-2"></i>Назад</a>
    </form>
</div>