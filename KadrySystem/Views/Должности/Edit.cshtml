@model KadrySystem.Models.Должность

@{
    ViewData["Title"] = "Редактирование должности";
}

<h1>Редактирование должности</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Код_должности" />
    <div class="form-group">
        <label>Наименование</label>
        <input asp-for="Наименование" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Оклад</label>
        <input asp-for="Оклад" class="form-control" type="number" step="0.01" required />
    </div>
    <div class="form-group">
        <label>Квалификационные требования</label>
        <textarea asp-for="Квалификационные_требования" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>