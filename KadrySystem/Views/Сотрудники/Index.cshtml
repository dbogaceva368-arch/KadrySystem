@model IEnumerable<KadrySystem.Models.Сотрудник>

@{
    ViewData["Title"] = "Сотрудники";
}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-users me-2" style="color:#2c5f8a"></i>Сотрудники</h1>
        <p>Управление личными карточками сотрудников Академического колледжа ИМСИТ</p>
    </div>
    <a asp-action="Create" class="btn btn-add"><i class="fas fa-plus me-2"></i>Добавить сотрудника</a>
</div>
<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Должность</th>
                <th>Подразделение</th>
                <th>Телефон</th>
                <th>Дата приёма</th>
                <th style="width: 150px">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Фамилия @item.Имя @item.Отчество</strong></td>
                    <td>@item.Должность?.Наименование</td>
                    <td>@item.Подразделение?.Наименование</td>
                    <td>@item.Телефон</td>
                    <td>@item.Дата_приема.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Код_сотрудника" class="btn btn-action btn-edit"><i class="fas fa-edit"></i> Ред.</a>
                        <a asp-action="Delete" asp-route-id="@item.Код_сотрудника" class="btn btn-action btn-delete"><i class="fas fa-trash"></i> Уд.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>