@model IEnumerable<KadrySystem.Models.Приказ>

@{
    ViewData["Title"] = "Приказы";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-file-alt me-2" style="color:#2c5f8a"></i>Приказы</h1>
        <p>Управление кадровыми приказами (приём, перевод, увольнение)</p>
    </div>
    <a asp-action="Create" class="btn btn-add"><i class="fas fa-plus me-2"></i>Добавить приказ</a>
</div>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Номер</th>
                <th>Дата</th>
                <th>Тип</th>
                <th>Основание</th>
                <th>Сотрудник</th>
                <th style="width: 150px">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Номер_приказа</strong></td>
                    <td>@item.Дата_издания.ToString("dd.MM.yyyy")</td>
                    <td>@item.Тип_приказа</td>
                    <td>@item.Основание</td>
                    <td>@item.Сотрудник?.Фамилия @item.Сотрудник?.Имя</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Код_приказа" class="btn btn-action btn-edit"><i class="fas fa-edit"></i> Ред.</a>
                        <a asp-action="Delete" asp-route-id="@item.Код_приказа" class="btn btn-action btn-delete"><i class="fas fa-trash"></i> Уд.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>